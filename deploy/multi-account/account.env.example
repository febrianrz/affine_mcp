# Satu file per akun. Jangan di-commit (.env.* sudah di-gitignore).
AFFINE_BASE_URL=https://affine.example.com
AFFINE_EMAIL=akun-khusus@example.com
AFFINE_PASSWORD=ganti-ini
# Opsional: kunci ke satu workspace
# AFFINE_WORKSPACE_ID=

# Batasi tool: read_only | core | authoring | full
AFFINE_TOOL_PROFILE=authoring
# Matikan operasi berbahaya sampai Anda yakin dengan perilaku AI
AFFINE_DISABLED_GROUPS=destructive,admin

# Auth untuk listener MCP ini. Buat unik per akun: openssl rand -hex 32
MCP_TRANSPORT=http
AFFINE_MCP_AUTH_MODE=bearer
AFFINE_MCP_HTTP_TOKEN=ganti-dengan-rahasia-acak
